# Astra DB Configuration (required)
ASTRA_DB_URL=https://your-astra-instance-id.apps.astra.datastax.com
ASTRA_DB_TOKEN=AstraCS:your-client-id:your-client-secret
CASSANDRA_KEYSPACE=default_keyspace

# Supabase Configuration (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_KEY=your-service-role-key

# ETL Configuration (optional)
ETL_BATCH_SIZE=1000
ETL_LOG_LEVEL=INFO
